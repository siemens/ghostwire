{
  "name": "ghostwire-webui",
  "version": "2.7.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace ghostwire-app dev",
    "build": "yarn workspace ghostwire-app build",
    "typecheck": "yarn workspaces foreach --all --topological run typecheck",
    "lint": "eslint .",
    "preview": "yarn workspace ghostwire-app preview",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "icons": "node genicons",
    "storybook": "yarn workspace ghostwire-ui storybook",
    "build-storybook": "yarn workspace ghostwire-ui build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@svgr/core": "^8.1.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "resolutions": {
    "@isaacs/brace-expansion": "^5.0.1",
    "rollup": "^4.59.0",
    "minimatch": "^10.2.1"
  },
  "packageManager": "yarn@4.18.1"
}
